# Copy to .env.test and replace placeholders with local-only credentials.
# compose.test.yaml fixes names and removes published ports; no development data.
NODE_ENV=test
PORT=3000
DOTENV_CONFIG_PATH=.env.test
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=replace-with-local-test-db-password
DB_NAME=streamtube_test
TEST_DB_NAME=streamtube_test
TEST_PROTECTED_DB_NAME=streamtube
JWT_SECRET=replace-with-local-test-jwt-secret
JWT_REFRESH_SECRET=replace-with-local-test-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube <noreply@streamtube.test>"
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=streamtube-test-videos
STORAGE_ACCESS_KEY=replace-with-local-test-storage-access-key
STORAGE_SECRET_KEY=replace-with-local-test-storage-secret-key
STORAGE_FORCE_PATH_STYLE=true
STORAGE_CORS_ORIGIN=http://streamtube.test:3000
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
VIDEO_QUEUE_PREFIX=streamtube-test
VIDEO_WORKER_CONCURRENCY=1
VIDEO_FFMPEG_THREADS=1
VIDEO_TEMP_DIRECTORY=/tmp/streamtube-videos
