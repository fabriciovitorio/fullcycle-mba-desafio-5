# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube <noreply@streamtube.com>"

# Private S3/MinIO storage. Supply real credentials in the local .env.
STORAGE_ENDPOINT=http://minio:9000
# Signing endpoint must resolve for the consumer; use a published hostname for external clients.
STORAGE_PUBLIC_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=streamtube-videos
STORAGE_ACCESS_KEY=replace-with-local-storage-access-key
STORAGE_SECRET_KEY=replace-with-local-storage-secret-key
STORAGE_FORCE_PATH_STYLE=true
STORAGE_CORS_ORIGIN=http://streamtube.local:3000

# Redis/BullMQ. Use a distinct prefix for the test worker.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
VIDEO_QUEUE_PREFIX=streamtube

# Operational limits. The public 10_000_000_000-byte ceiling and 64MiB part size are fixed in code.
VIDEO_UPLOAD_TTL_SECONDS=86400
VIDEO_SIGNED_URL_TTL_SECONDS=900
VIDEO_WORKER_CONCURRENCY=1
VIDEO_FFMPEG_THREADS=1
VIDEO_PROBE_TIMEOUT_MS=60000
VIDEO_PROCESSING_TIMEOUT_MS=3600000
VIDEO_PROCESSING_LEASE_MS=60000
VIDEO_PROCESSING_HEARTBEAT_INTERVAL_MS=10000
VIDEO_CLEANUP_GRACE_SECONDS=86400
VIDEO_TEMP_DIRECTORY=/tmp/streamtube-videos
