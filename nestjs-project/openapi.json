            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Resume a video upload",
        "tags": [
          "videos"
        ]
      },
      "delete": {
        "description": "Aborts the owner draft multipart session and retains the video with UPLOAD_ABORTED. Repeated abort returns the same empty 204. Accepts no request body; does not delete a video. Already completed source objects are reconciled instead of incorrectly confirming abort.",
        "operationId": "VideosUploadsController_abort",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Video owned by the authenticated user channel.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Upload aborted, or already aborted; no response body"
          },
          "400": {
            "description": "VALIDATION_ERROR: invalid UUID or request body supplied",
            "content": {
              "application/json": {
                "schema": {
