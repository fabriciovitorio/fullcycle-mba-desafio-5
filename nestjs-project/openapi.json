    "/videos/{id}/upload/completion": {
      "post": {
        "description": "Confirms authoritative storage parts and atomically persists processing with one outbox intention. Accepts no request body or client sizes/ETags. Repeated processing returns 202; an already ready video returns 200 without repeating processing.",
        "operationId": "VideosUploadsController_complete",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Video owned by the authenticated user channel.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Already ready; identity and published data preserved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoUploadCompletionDto"
                }
              }
            }
          },
          "202": {
            "description": "Upload completed and processing accepted, or processing replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoUploadCompletionDto"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR: invalid UUID or request body supplied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "VIDEO_NOT_FOUND: absent video or different owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "UPLOAD_INCOMPLETE, UPLOAD_SIZE_MISMATCH, UPLOAD_OPERATION_IN_PROGRESS or INVALID_VIDEO_STATE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "UPLOAD_EXPIRED: expired session without a recoverable completed source",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "JSON control body exceeds 64KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Control limit exceeded (120 requests per minute)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "STORAGE_UNAVAILABLE: storage operation could not be confirmed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Complete a video upload",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "new_password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "new_password"
        ]
      },
      "CreateVideoUploadDto": {
        "type": "object",
        "properties": {
          "sizeBytes": {
            "type": "integer",
            "description": "Declared file size in bytes; maximum 10GB (decimal).",
            "minimum": 1,
            "maximum": 10000000000
          },
          "title": {
            "type": "string",
            "description": "Video title, trimmed before validation (1–200 characters).",
            "minLength": 1,
            "maxLength": 200
          },
          "fileName": {
            "type": "string",
            "description": "Original file name; no NUL, slash, backslash, CR or LF (1–255 characters).",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^/\\\\\\r\\n]+$"
          },
          "contentType": {
            "type": "string",
            "description": "Declared MIME type. Actual video content is validated during processing.",
            "enum": [
              "video/mp4"
            ]
          }
        },
        "required": [
          "sizeBytes",
          "title",
          "fileName",
          "contentType"
        ]
      },
      "VideoStatusDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "error"
            ]
          },
          "errorCode": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "slug",
          "status",
          "errorCode",
          "createdAt",
          "updatedAt"
        ]
      },
      "VideoUploadSessionDto": {
        "type": "object",
        "properties": {
          "partSizeBytes": {
            "type": "number",
            "enum": [
              67108864
            ]
          },
          "partCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 150
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "partSizeBytes",
          "partCount",
          "expiresAt"
        ]
      },
      "VideoUploadInitializationDto": {
        "type": "object",
        "properties": {
          "video": {
            "$ref": "#/components/schemas/VideoStatusDto"
          },
          "upload": {
            "$ref": "#/components/schemas/VideoUploadSessionDto"
          }
        },
        "required": [
          "video",
          "upload"
        ]
      },
      "VideoUploadPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 150
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          },
          "etag": {
            "type": "string",
            "description": "ETag observed by storage, including quotes."
          }
        },
        "required": [
          "partNumber",
          "sizeBytes",
          "etag"
        ]
      },
      "VideoUploadResumeSessionDto": {
        "type": "object",
        "properties": {
          "partSizeBytes": {
            "type": "number",
            "enum": [
              67108864
            ]
          },
          "partCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 150
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VideoUploadPartDto"
            }
          }
        },
        "required": [
          "partSizeBytes",
          "partCount",
          "expiresAt",
          "parts"
        ]
      },
      "VideoUploadResumeDto": {
        "type": "object",
        "properties": {
          "video": {
            "$ref": "#/components/schemas/VideoStatusDto"
          },
          "upload": {
            "$ref": "#/components/schemas/VideoUploadResumeSessionDto"
          }
        },
        "required": [
          "video",
          "upload"
        ]
      },
      "SignVideoUploadPartsDto": {
        "type": "object",
        "properties": {
          "partNumbers": {
            "type": "array",
            "description": "Distinct part numbers (1–50 per request), each within this upload's part count.",
            "minimum": 1,
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "maxItems": 50
          }
        },
        "required": [
          "partNumbers"
        ]
      },
      "VideoUploadPartHeadersDto": {
        "type": "object",
        "properties": {
          "Content-Length": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$",
            "description": "Exact byte length required by the signed PUT."
          }
        },
        "required": [
          "Content-Length"
        ]
      },
      "VideoUploadPartPermissionDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 150
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Temporary PUT permission at the configured storage origin. Use unchanged."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Expires within 900 seconds and no later than the upload session."
          },
          "headers": {
            "$ref": "#/components/schemas/VideoUploadPartHeadersDto"
          }
        },
        "required": [
          "partNumber",
          "url",
          "expiresAt",
          "headers"
        ]
      },
      "VideoUploadPermissionsDto": {
        "type": "object",
        "properties": {
          "parts": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VideoUploadPartPermissionDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "VideoUploadCompletionDto": {
        "type": "object",
        "properties": {
          "video": {
            "$ref": "#/components/schemas/VideoStatusDto"
          }
        },
        "required": [
          "video"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "description": "Domain or validation error code; inherited framework errors may omit this field.",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      }
    }
  }
}