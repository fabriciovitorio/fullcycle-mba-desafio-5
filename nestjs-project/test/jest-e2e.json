{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/../src/test/global-setup.ts",
  "setupFiles": ["dotenv/config", "<rootDir>/../src/test/setup-test-env.ts"]
}
