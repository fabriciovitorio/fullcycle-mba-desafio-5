{
  "status": "passed",
  "artifact": "nestjs-project/openapi.json",
  "sha256": "a41349653a7524389abeb7c8de076e033d4ed6312436fb7eaac1779d68a1862a",
  "operation": {
    "description": "Issues temporary direct-to-storage PUT permissions for 1–50 unique part numbers within the owner draft session. Expected lengths are calculated by the server. URLs expire within 15 minutes and never after the session; send binary bytes directly to storage with the returned headers.",
    "operationId": "VideosUploadsController_signParts",
    "parameters": [
      {
        "name": "id",
        "required": true,
        "in": "path",
        "description": "Video owned by the authenticated user channel.",
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/SignVideoUploadPartsDto"
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Temporary upload permissions for the requested parts",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VideoUploadPermissionsDto"
            }
          }
        }
      },
      "400": {
        "description": "VALIDATION_ERROR: invalid UUID, duplicate/invalid/out-of-range parts or batch outside 1–50",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "401": {
        "description": "Missing or invalid access token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "404": {
        "description": "VIDEO_NOT_FOUND: absent video or different owner",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "409": {
        "description": "INVALID_VIDEO_STATE or UPLOAD_OPERATION_IN_PROGRESS",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "410": {
        "description": "UPLOAD_EXPIRED: expired session without a recoverable completed source",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "413": {
        "description": "JSON control body exceeds 64KiB",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "429": {
        "description": "Control limit exceeded (120 requests per minute)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "503": {
        "description": "STORAGE_UNAVAILABLE: storage operation or signing could not be confirmed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      }
    },
    "security": [
      {
        "access-token": []
      }
    ],
    "summary": "Authorize video upload parts",
    "tags": [
      "videos"
    ]
  },
  "request_schema": {
    "type": "object",
    "properties": {
      "partNumbers": {
        "type": "array",
        "description": "Distinct part numbers (1–50 per request), each within this upload's part count.",
        "minimum": 1,
        "uniqueItems": true,
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "maxItems": 50
      }
    },
    "required": [
      "partNumbers"
    ]
  },
  "response_schemas": {
    "VideoUploadPermissionsDto": {
      "type": "object",
      "properties": {
        "parts": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/VideoUploadPartPermissionDto"
          }
        }
      },
      "required": [
        "parts"
      ]
    },
    "VideoUploadPartPermissionDto": {
      "type": "object",
      "properties": {
        "partNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Temporary PUT permission at the configured storage origin. Use unchanged."
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Expires within 900 seconds and no later than the upload session."
        },
        "headers": {
          "$ref": "#/components/schemas/VideoUploadPartHeadersDto"
        }
      },
      "required": [
        "partNumber",
        "url",
        "expiresAt",
        "headers"
      ]
    },
    "VideoUploadPartHeadersDto": {
      "type": "object",
      "properties": {
        "Content-Length": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "description": "Exact byte length required by the signed PUT."
        }
      },
      "required": [
        "Content-Length"
      ]
    }
  },
  "checks": [
    "JWT",
    "UUID path",
    "required JSON request",
    "unique integer array of 1..50",
    "200 rather than default POST201",
    "all documented errors reference common envelope",
    "nested exact Content-Length string header",
    "URI and date-time response formats",
    "all previously committed operations unchanged"
  ]
}
